# Plantilla de secretos para desarrollo local.
# Copiar este archivo a secrets.properties (gitignored) y completar con valores reales.
# application-dev.properties lo importa con: spring.config.import=optional:file:./secrets.properties
#
# IMPORTANTE: secrets.properties NUNCA se commitea (esta en .gitignore).

# Access token de MercadoPago (requerido: sin esto el perfil dev no arranca)
MERCADOPAGO_ACCESS_TOKEN=change_me

# Credenciales SMTP de Gmail (app password). Opcionales: si se dejan vacias,
# el envio de mails no funcionara pero la app arranca igual.
MAIL_USERNAME=change_me@gmail.com
MAIL_PASSWORD=change_me
